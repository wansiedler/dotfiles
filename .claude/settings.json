{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "switchModelsOnFlag": false,
  "enableAllProjectMcpServers": false,
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.aws/sso/cache/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.aws/**)",
      "Edit(**/.git/hooks/**)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm -rf *)",
      "Bash(mkfs*)",
      "Bash(sudo mkfs*)",
      "Bash(dd if=*of=/dev/*)",
      "Bash(sudo dd *)",
      "Bash(chmod -R 777 *)",
      "Bash(sudo chmod -R 777 *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(curl * | sudo *)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(git push*--force)",
      "Bash(git push*--force *)",
      "Bash(git push*-f)",
      "Bash(git push*-f *)",
      "Bash(git push*--mirror*)",
      "Bash(git push*--delete*develop*)",
      "Bash(git push*--delete*main*)",
      "Bash(git push*--delete*master*)",
      "Bash(git filter-branch*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret*)",
      "Bash(gh auth token*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat ~/.aws/credentials*)",
      "Bash(cat ~/.claude/.credentials.json*)",
      "Bash(printenv)",
      "Bash(env)"
    ],
    "ask": [
      "Bash(git push*--force-with-lease*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git config --global *)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh release delete*)",
      "Bash(docker system prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker volume prune*)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.bashrc)",
      "Edit(~/.profile)"
    ]
  }
}
